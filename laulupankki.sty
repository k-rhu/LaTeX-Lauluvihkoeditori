%---------------------------------------------
%       OHJEET LAULUPANKIN KÄYTTÄJÄLLE
%---------------------------------------------
%
%               Laulut määritellään laulupankissa uusina komentoina \newcommand{\laulu}{
%
%               }
%               -tyylillä. Aloita lalulu tämän jälkeen otsikolla \section{}
%
%               Laulupankissa käytetään \newommand{}:ia \def:n sijasta, jottei vahingossa
%               korvata olemassa olevia LaTeXin komentoja.
%
%               Laulupankissa käytetään verse-pakettia. Aloita laulun komennolla
%               \begin{verse}
%               samoiten laulu päättyy komennolla 
%               \end{verse}
%
%               Laulun sisällä rivinvaihdot tehdään kahdella alamäellä
%               \\
%
%               Säkeistön päätteeksi saat skipattua rivin kahdella alamäellä ja huutomerkillä
%               \\!
%
%               Jotta säkeistöt eivät leikkaannu puolivälistä kolumnin tai sivun loppuessa,
%               käytössä on needspace-paketti. Tällä voidaan määritellä rivien määrä, jota
%               osio tarvitsee pysyäkseen kasassa
%               
%               \needspace{1\baslineskip} -komennon sijaan voit käyttää alla
%               määriteltyä komentoa, luotu taiteilijan ajan säästämiseksi
%

\newcommand{\ns}[1]{\needspace{#1\baselineskip}}

%
%               Nyt komento toimii lyhyellä \ns{} -komennolla, jossa sulkeiden sisään 
%               laitetaan tarvittava rivien määrä
%

%
%           Lisäksi määriteltiin komento laulun osien poistamiselle, jotta ei tarvitse
%           kommentoida tai poistaa säkeistöjä ym. rivi kerrallaan aina eri sitsejä varten
%

\newcommand{\poisto}[1]{}

%
%           Voit poistaa säkeistöä ym. komennolla \poisto{}, jossa poistettava osa
%           laitetaan kaarisulkeiden sisään. Muista ottaa \ns{} -komennot mukaan poistoon,
%           jottei läsyyn tulostu turhaan tyhjiä osia.
%
%       --------------------------------
%           Yleisesti formatoinnista
%       --------------------------------

%           - Hyvä tapa on merkata laulun sävel sulkeisiin ja italiccina laulun alkuun
%           ==> käytä \textit{}:tä tätä varten
%
%           - Mikäli laulussa kerrataan jokin osa, älä kirjoita koko osaa uudelleen, vaan
%           lisää kertausmerkit :,: säkeistön molemmille puolin.
%           - Jos taas jokin säkeistö toistetaan myöhemmin, voit kirjottaa säkeistön alun
%           ja laittaa kolme pistettä (\dots) perään, jolloin aasinkin tulisi tajuta
%           katsoa sanoja ylempää, jos on tarve.
%           
%           - Formatointi verse-paketissa menee oudoksi sisennyksineen, jos rivin pituus
%           ylittää kolumin leveyden. Katkaise ylipitkät rivit soveltuvilta osin ja siirrä
%           seuraavalle riville.
%
%           Ota mallia alla olevista lauluista, ja lisää omasi tarvittaessa listan loppuun
%

